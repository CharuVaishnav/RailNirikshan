{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd backend && .venv\\Scripts\\python -m uvicorn app.main:app --host 0.0.0.0 --port 8000"],
      "port": 8000
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd dashboard && npm run dev"],
      "port": 5173
    },
    {
      "name": "dashboard-phone",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd dashboard && npm run dev:phone -- --port 5174 --strictPort"],
      "port": 5174,
      "url": "https://localhost:5174"
    }
  ]
}
