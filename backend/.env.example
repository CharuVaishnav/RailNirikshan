# Copy this file to .env and change values as needed.

# SQLite (no Docker needed) - good for the first few weeks:
DATABASE_URL=sqlite:///./railnirikshan.db
# PostgreSQL from docker-compose:
# DATABASE_URL=postgresql+psycopg://rail:rail@localhost:5432/railnirikshan

JWT_SECRET=change-me-to-a-long-random-string

# Photo storage: local = uploads/ folder on the server disk (free, recommended)
STORAGE_BACKEND=local

# AI (optional). Leave empty until the models are ready.
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:3b
YOLO_MODEL_PATH=

# Free email alerts (Gmail: turn on 2-step verification, then create an "app password").
# Leave SMTP_USER empty to switch alerts off.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
